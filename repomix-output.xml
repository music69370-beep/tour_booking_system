<script>
let rowIdx = 0;

function addVehicleRow() {
    rowIdx++;
    const html = `
        <div class="vehicle-row p-3 mb-3 border rounded-4 bg-light shadow-sm" id="row-${rowIdx}">
            <div class="row g-3 align-items-end">
