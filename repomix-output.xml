if (isset($_GET['id'])) {
    $id = mysqli_real_escape_string($conn, $_GET['id']);
    $status = isset($_GET['status']) ? $_GET['status'] : 'all';

    mysqli_query($conn, "DELETE FROM booking_participants WHERE booking_id = '$id'");
