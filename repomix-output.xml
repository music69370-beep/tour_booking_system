        // 3. àº¥àº¶àºšàº‚à»à»‰àº¡àº¹àº™à»ƒàº™ Database
        $sql = "DELETE FROM vehicles WHERE vehicle_id = '$id'";
        if (mysqli_query($conn, $sql)) {
            header("Location: index.php?msg=deleted");
            exit();
        }
    }
