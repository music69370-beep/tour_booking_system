if (isset($_POST['code'])) {
    $code = strtoupper(mysqli_real_escape_string($conn, $_POST['code']));
    $tour_id = $_POST['tour_id'];
    $subtotal = $_POST['subtotal'];
    $phone = $_POST['phone']; // à»ƒàºŠà»‰à»€àºšàºµà»‚àº—à»€àºžàº·à»ˆàº­àºàº§àº”àºªàº­àºšàºªàº´àº”/àº„àº»àº™
    $today = date('Y-m-d');

    // 1. àº”àº¶àº‡àº‚à»à»‰àº¡àº¹àº™àº„àº¹àº›àº­àº‡
    $sql = "SELECT * FROM coupons WHERE code = '$code' AND status = 'Active' AND expiry_date >= '$today'";
    $res = mysqli_query($conn, $sql);
    $coupon = mysqli_fetch_assoc($res);

    if (!$coupon) {
        echo json_encode(['status' => 'error', 'message' => 'àº¥àº°àº«àº±àº”àºšà»à»ˆàº–àº·àºàº•à»‰àº­àº‡ àº«àº¼àº· à»àº»àº”àº­àº²àºàº¸']);
        exit;
    }

    // 2. àºàº§àº”àºªàº­àºšàºàº­àº”àºŠàº·à»‰àº‚àº±à»‰àº™àº•à»ˆàº³
    if ($subtotal < $coupon['min_spend']) {
        echo json_encode(['status' => 'error', 'message' => 'àºàº­àº”àºˆàº­àº‡àº•à»‰àº­àº‡àº®àº­àº” '.number_format($coupon['min_spend']).' àºàºµàºš']);
        exit;
    }

    // 3. àºàº§àº”àºªàº­àºšàº§à»ˆàº²à»ƒàºŠà»‰àºàº±àºšàº—àº»àº§àº™àºµà»‰à»„àº”à»‰àºšà»à»ˆ
    if ($coupon['specific_tour_id'] !== NULL && $coupon['specific_tour_id'] != $tour_id) {
        echo json_encode(['status' => 'error', 'message' => 'àº¥àº°àº«àº±àº”àº™àºµà»‰à»ƒàºŠà»‰àºšà»à»ˆà»„àº”à»‰àºàº±àºšà»àºžàº±àºà»€àºàº±àº”àº™àºµà»‰']);
        exit;
    }

    // 4. àºàº§àº”àºªàº­àºšàºªàº´àº”àº—àº±àº‡à»àº»àº” (Total Limit)
    $cid = $coupon['coupon_id'];
    $used_total = mysqli_fetch_assoc(mysqli_query($conn, "SELECT COUNT(*) as c FROM bookings WHERE coupon_id = $cid AND status != 'Cancelled'"))['c'];
    if ($coupon['total_limit'] > 0 && $used_total >= $coupon['total_limit']) {
        echo json_encode(['status' => 'error', 'message' => 'àºªàº´àº”à»€àº•àº±àº¡à»àº¥à»‰àº§']);
        exit;
    }

    // 5. àºàº§àº”àºªàº­àºšàºªàº´àº”/àº„àº»àº™ (Limit per User)
    $used_user = mysqli_fetch_assoc(mysqli_query($conn, "SELECT COUNT(*) as c FROM bookings b JOIN customers c ON b.customer_id = c.customer_id WHERE b.coupon_id = $cid AND c.phone = '$phone' AND b.status != 'Cancelled'"))['c'];
    if ($used_user >= $coupon['limit_per_user']) {
        echo json_encode(['status' => 'error', 'message' => 'àº—à»ˆàº²àº™à»ƒàºŠà»‰àº¥àº°àº«àº±àº”àº™àºµà»‰àº„àº»àºšàº•àº²àº¡àºªàº´àº”à»àº¥à»‰àº§']);
        exit;
    }

    // 6. àº„àº³àº™àº§àº™àºªà»ˆàº§àº™àº«àº¼àº¸àº”à»àº—à»‰
    $discount = 0;
    if ($coupon['discount_type'] == 'Fixed') {
        $discount = $coupon['discount_value'];
    } else {
        $discount = ($subtotal * $coupon['discount_value']) / 100;
        if ($coupon['max_discount'] > 0 && $discount > $coupon['max_discount']) {
            $discount = $coupon['max_discount'];
        }
    }

    echo json_encode([
        'status' => 'success',
        'discount' => $discount,
        'id' => $cid
    ]);
    exit;
}
