    mysqli_begin_transaction($conn);

    try {
        // 1. àº¥àº¶àºšàº¥àº²àºàºŠàº·à»ˆàºœàº¹à»‰àº®à»ˆàº§àº¡àº—àº²àº‡ àº—àºµà»ˆàºœàº¹àºàºàº±àºšàºàº²àº™àºˆàº­àº‡àº‚àº­àº‡àº¥àº¹àºàº„à»‰àº²àº™àºµà»‰
        mysqli_query($conn, "DELETE FROM booking_participants WHERE booking_id IN (SELECT booking_id FROM bookings WHERE customer_id = '$id')");

        // 2. àº¥àº¶àºšàº›àº°àº«àº§àº±àº”àºàº²àº™àºˆà»ˆàº²àºà»€àº‡àº´àº™ àº‚àº­àº‡àº¥àº¹àºàº„à»‰àº²àº™àºµà»‰
        mysqli_query($conn, "DELETE FROM payments WHERE booking_id IN (SELECT booking_id FROM bookings WHERE customer_id = '$id')");

        // 3. àº¥àº¶àºšàºàº²àº™àºˆàº­àº‡ (Bookings) àº‚àº­àº‡àº¥àº¹àºàº„à»‰àº²àº™àºµà»‰
        mysqli_query($conn, "DELETE FROM bookings WHERE customer_id = '$id'");

        // 4. àº¥àº¶àºšàº•àº»àº§àº¥àº¹àºàº„à»‰àº² (Customer)
        mysqli_query($conn, "DELETE FROM customers WHERE customer_id = '$id'");

        // àº¢àº·àº™àº¢àº±àº™àºàº²àº™àº¥àº¶àºšàº—àº±àº‡à»àº»àº”
        mysqli_commit($conn);
        header("Location: index.php?msg=deleted");
        exit();

    } catch (Exception $e) {
        // àº–à»‰àº²àºœàº´àº”àºžàº²àº” à»ƒàº«à»‰àºàº»àºà»€àº¥àºµàºàº—àº¸àºàº¢à»ˆàº²àº‡
        mysqli_rollback($conn);
        header("Location: index.php?msg=error");
        exit();
    }
}
