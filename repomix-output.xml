        // 3. ລຶບໄຟລ໌ຮູບພາບອອກຈາກ Folder
        if (file_exists("../../assets/uploads/tours/" . $image_name)) {
            unlink("../../assets/uploads/tours/" . $image_name);
        }
        header("Location: index.php?msg=deleted");
    }
}
?>
