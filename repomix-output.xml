        cancelButtonColor: '#6c757d',
        confirmButtonText: 'ລຶບທັນທີ',
        cancelButtonText: 'ຍົກເລີກ',
        reverseButtons: true
    }).then((result) => {
        if (result.isConfirmed) {
            navigateTo(id, url);
        }
