    $check_duplicate = mysqli_query($conn, "SELECT booking_id FROM bookings 
        WHERE customer_id = '$customer_id' 
        AND tour_id = '$tour_id' 
        AND travel_date = '$travel_date' 
        AND selected_seats = '$selected_seats' 
